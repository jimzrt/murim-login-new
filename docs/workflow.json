{
  "version": 1,
  "coordinator_model": "openai-codex/gpt-5.6-luna:high",
  "draft_model": "openai-codex/gpt-5.6-luna:high",
  "review_model": "openai-codex/gpt-5.6-sol:medium",
  "revision_model": "openai-codex/gpt-5.6-luna:high",
  "context_max_bytes": 16384,
  "continuity_source_limit": 2,
  "packet_token_limits": {
    "draft": 60000,
    "review": 60000,
    "revision": 60000,
    "checkpoint": 120000
  },
  "summary_interval": 5,
  "checkpoint_review_interval": 5,
  "checkpoint_evaluation_window": 20,
  "retrofit_block_size": 5,
  "retrofit_parallel_jobs": 2,
  "retrofit_review_token_limit": 70000,
  "retrofit_refine_token_limit": 80000,
  "retrofit_min_auto_confidence": 0.8
}
